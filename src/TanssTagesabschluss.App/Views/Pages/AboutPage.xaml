<Page x:Class="TanssTagesabschluss.App.Views.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:design="clr-namespace:TanssTagesabschluss.App.Design"
      Style="{StaticResource PageSurface}"
      ScrollViewer.CanContentScroll="False"
      Title="Über">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PagePadding}" MaxWidth="980"
                    HorizontalAlignment="Left" design:Spacing.Size="16">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Left" Margin="0,0,16,0"
                            design:Spacing.Size="16">
                    <!-- Das Logo steht ohne Kasten da. Die Vorlage bringt ihre Durchsichtigkeit
                         schon mit (742x258, 32 Bit mit Alphakanal), und die Hausfarben tragen
                         auf hellem wie auf dunklem Grund. -->
                    <Image Source="/Assets/pronet-logo.png"
                           Width="240" HorizontalAlignment="Left"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Stretch="Uniform" />

                    <StackPanel>
                        <ui:TextBlock Text="{Binding Product}" FontTypography="Title"
                                      HorizontalAlignment="Left" />
                        <ui:TextBlock HorizontalAlignment="Left" Margin="0,2,0,0"
                                      TextWrapping="Wrap"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="Findet die Zeitfenster, in denen gearbeitet, aber keine Leistung erfasst wurde — und schliesst sie." />
                    </StackPanel>
                </StackPanel>

                <ui:Button Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right"
                           Content="pronet-systems.de" Icon="{ui:SymbolIcon Globe24}"
                           Appearance="Secondary"
                           ToolTip="Öffnet die Anschrift im eingestellten Browser"
                           Command="{Binding OpenWebsiteCommand}" />
            </Grid>

            <Border Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ui:TextBlock Grid.Row="0" Grid.Column="0" Text="Version" Margin="0,0,0,8"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                                  HorizontalAlignment="Left"
                                  Style="{StaticResource TabularText}"
                                  Text="{Binding VersionText}" />

                    <ui:TextBlock Grid.Row="1" Grid.Column="0" Text="Laufzeit" Margin="0,0,0,8"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                                  HorizontalAlignment="Left" TextWrapping="Wrap"
                                  Text="{Binding Runtime}" />

                    <ui:TextBlock Grid.Row="2" Grid.Column="0" Text="Betriebssystem"
                                  Margin="0,0,0,8"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"
                                  HorizontalAlignment="Left" TextWrapping="Wrap"
                                  Text="{Binding OperatingSystemName}" />

                    <ui:TextBlock Grid.Row="3" Grid.Column="0" Text="Entwicklung"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBlock Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left"
                                  TextWrapping="Wrap" Text="{Binding Company}" />
                </Grid>
            </Border>

            <!-- ===== Aktualisierung =================================================== -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel design:Spacing.Size="12">
                    <ui:TextBlock Text="Aktualisierung" FontTypography="Subtitle" />
                    <ui:TextBlock Text="{Binding StateText}" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" design:Spacing.Size="8">
                        <ui:Button Content="Nachsehen" Icon="{ui:SymbolIcon ArrowSync24}"
                                   Appearance="Secondary"
                                   Command="{Binding CheckCommand}"
                                   IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        <!-- Bewusst der Browser und kein Herunterladen im Fenster: Wer eine
                             neue Fassung einspielt, soll vorher lesen, was sich geändert hat. -->
                        <ui:Button Content="Veröffentlichung öffnen" Icon="{ui:SymbolIcon Open24}"
                                   Appearance="Secondary"
                                   Command="{Binding OpenReleasesCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Die Pfade stehen hier, weil bei jeder Rückfrage als Zweites nach ihnen
                 gefragt wird. Sie zu suchen kostet mehr Zeit als sie anzuzeigen. -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel design:Spacing.Size="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBlock Grid.Column="0" Text="Wo was liegt"
                                      FontTypography="BodyStrong" VerticalAlignment="Center"
                                      HorizontalAlignment="Left" />
                        <ui:Button Grid.Column="1" Content="Ordner öffnen"
                                   Icon="{ui:SymbolIcon FolderOpen24}" Appearance="Secondary"
                                   Command="{Binding OpenConfigFolderCommand}" />
                    </Grid>

                    <ui:TextBlock Text="Konfiguration" FontSize="11" HorizontalAlignment="Left"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBlock Text="{Binding ConfigPath}" TextWrapping="Wrap"
                                  HorizontalAlignment="Left" FontSize="12"
                                  Style="{StaticResource TabularText}" />

                    <ui:TextBlock Text="Arbeitstoken (DPAPI-verschlüsselt)" FontSize="11"
                                  Margin="0,4,0,0" HorizontalAlignment="Left"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBlock Text="{Binding TokenPath}" TextWrapping="Wrap"
                                  HorizontalAlignment="Left" FontSize="12"
                                  Style="{StaticResource TabularText}" />

                    <ui:TextBlock Text="Feiertagszwischenspeicher" FontSize="11" Margin="0,4,0,0"
                                  HorizontalAlignment="Left"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBlock Text="{Binding HolidayCachePath}" TextWrapping="Wrap"
                                  HorizontalAlignment="Left" FontSize="12"
                                  Style="{StaticResource TabularText}" />
                </StackPanel>
            </Border>

            <!-- ===== Was dieses Werkzeug nicht tut ==================================== -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel design:Spacing.Size="8">
                    <ui:TextBlock Text="Was dieses Werkzeug nicht tut" FontTypography="Subtitle" />
                    <!-- Ausdrücklich auf einer sichtbaren Seite und nicht nur im Quelltext:
                         Wer ein Werkzeug an seine Arbeitszeiten lässt, soll wissen, wo dessen
                         Grenzen verlaufen. -->
                    <ui:TextBlock FontSize="12" TextWrapping="Wrap"
                                  Text="• Es setzt keine Zeitstempel. Kommen, Gehen und Pausen werden gelesen, niemals geschrieben." />
                    <ui:TextBlock FontSize="12" TextWrapping="Wrap"
                                  Text="• Es schliesst keinen Tag in der Zeiterfassung ab. Der Tagesabschluss bleibt eine Entscheidung in TANSS." />
                    <ui:TextBlock FontSize="12" TextWrapping="Wrap"
                                  Text="• Es bucht nichts von selbst. Jede Leistung entsteht, weil jemand sie geschrieben und bestätigt hat." />
                    <ui:TextBlock FontSize="12" TextWrapping="Wrap"
                                  Text="• Es übermittelt nichts nach draussen, solange die Sprachmodell-Unterstützung aus ist. Feiertage und Postleitzahl sind die Ausnahme — dorthin gehen ein Jahr, ein Länderkürzel und eine Postleitzahl, sonst nichts." />
                </StackPanel>
            </Border>

            <ui:TextBlock Text="{Binding Copyright}" FontSize="11" HorizontalAlignment="Left"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
