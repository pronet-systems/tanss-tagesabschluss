<Page x:Class="TanssTagesabschluss.App.Views.Pages.DayPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:design="clr-namespace:TanssTagesabschluss.App.Design"
      Style="{StaticResource PageSurface}"
      Title="Tag">

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Kopf: Datum, Blättern, Neu laden ===================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <ui:TextBlock Text="{Binding DateHeadline}" FontTypography="Title" />
                <ui:TextBlock Text="{Binding VerdictText}" TextWrapping="Wrap" Margin="0,4,0,0"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                        design:Spacing.Size="8">
                <ui:Button Icon="{ui:SymbolIcon ChevronLeft24}" ToolTip="Ein Tag zurück"
                           Command="{Binding PreviousDayCommand}" />
                <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                            VerticalContentAlignment="Center" MinWidth="150" />
                <ui:Button Icon="{ui:SymbolIcon ChevronRight24}" ToolTip="Ein Tag vor"
                           Command="{Binding NextDayCommand}" />
                <ui:Button Content="Heute" Command="{Binding TodayCommand}" />
                <ui:Button Icon="{ui:SymbolIcon ArrowSync24}" Content="Neu laden"
                           Command="{Binding ReloadCommand}" />
            </StackPanel>
        </Grid>

        <!-- ===== Kennzahlen: Deckung, Pausen, Hinweise, Fehler ======================== -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16" design:Spacing.Size="12">

            <!-- Der Balken beantwortet die Frage „ist da noch etwas offen“ mit einem Blick. -->
            <Border Style="{StaticResource CardBorder}"
                    Visibility="{Binding IsConfigured, Converter={StaticResource BoolToVis}}">
                <StackPanel design:Spacing.Size="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0" Text="{Binding CoverageText}" />
                        <ui:TextBlock Grid.Column="1" Text="{Binding PauseText}" FontSize="12"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <!-- Zwei Rechtecke übereinander statt eines ProgressBar: Der Fortschritt
                         ist hier kein Vorgang, sondern ein Anteil, und ein ProgressBar wirkt
                         wie etwas, das gleich fertig wird. -->
                    <Border Style="{StaticResource CoverageTrack}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding CoverageStar}" />
                                <ColumnDefinition Width="{Binding RemainderStar}" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource GapCoveredBrush}"
                                    CornerRadius="3" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Hinweise zur Rechnung: was nicht ermittelt werden konnte und was das bedeutet. -->
            <Border Style="{StaticResource CardBorder}"
                    Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <ui:SymbolIcon Symbol="Info24" FontSize="16" Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                        <ui:TextBlock Text="Zur Rechnung" FontTypography="BodyStrong"
                                      VerticalAlignment="Center" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Notes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"
                                              Margin="24,0,0,4"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <ui:InfoBar Severity="Error" IsClosable="False" IsOpen="True"
                        Title="Nicht geladen"
                        Message="{Binding Error}"
                        Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />

            <ui:ProgressRing IsIndeterminate="True" Width="28" Height="28"
                             HorizontalAlignment="Left"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <!-- ===== Die beiden Listen ==================================================== -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel design:Spacing.Size="16">

                <!-- === Lücken: der Ort, an dem etwas entsteht ========================= -->
                <StackPanel Visibility="{Binding HasGaps, Converter={StaticResource BoolToVis}}">
                    <ui:TextBlock Text="Offene Zeitfenster" FontTypography="Subtitle"
                                  Margin="0,0,0,8" />

                    <ItemsControl ItemsSource="{Binding Gaps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                                    <StackPanel design:Spacing.Size="8">

                                        <!-- Zeile 1: Wann, wie lange, und was drumherum stand -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ui:TextBlock Grid.Column="0" Text="{Binding Time}"
                                                          Style="{StaticResource TabularText}"
                                                          FontTypography="BodyStrong"
                                                          Margin="0,0,12,0" />

                                            <Border Grid.Column="1" Style="{StaticResource StatePillOnColor}"
                                                    Background="{DynamicResource GapOpenBrush}"
                                                    Margin="0,0,12,0">
                                                <ui:TextBlock Text="{Binding Duration}" FontSize="11" />
                                            </Border>

                                            <!-- DER EIGENTLICHE NUTZEN DER LISTE: „09:15–10:00“
                                                 allein sagt niemandem, was er da getan hat;
                                                 „davor: Drucker eingerichtet“ bringt die
                                                 Erinnerung zurück. -->
                                            <ui:TextBlock Grid.Column="2" Text="{Binding Context}"
                                                          FontSize="12" TextTrimming="CharacterEllipsis"
                                                          VerticalAlignment="Center"
                                                          ToolTip="{Binding Context}"
                                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                            <!-- Teilen. Neun offene Stunden am Stueck sind
                                                 fast nie neun Stunden an derselben Sache;
                                                 ohne Teilen bliebe nur, alles in EINEN
                                                 Leistungstext zu schreiben und auf EIN Ticket
                                                 zu buchen. Auf der Rechnung des Kunden waere
                                                 das nicht mehr auseinanderzuhalten.

                                                 Angegeben wird eine UHRZEIT und keine Dauer:
                                                 Wer aufteilt, weiss, wann er beim einen Kunden
                                                 aufgehoert hat, nicht wie viele Minuten das
                                                 waren. -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Margin="12,0,12,0"
                                                        Visibility="{Binding CanBook, Converter={StaticResource BoolToVis}}">
                                                <ui:TextBlock Text="Erster Teil" FontSize="12"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,8,0"
                                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <ui:TextBlock Text="{Binding StartText}" FontSize="12"
                                                              Style="{StaticResource TabularText}"
                                                              VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <ui:TextBlock Text="bis" FontSize="12"
                                                              VerticalAlignment="Center" Margin="0,0,6,0"
                                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <ui:TextBox Text="{Binding SplitAt, UpdateSourceTrigger=PropertyChanged}"
                                                            MinWidth="72" Margin="0,0,8,0"
                                                            PlaceholderText="HH:mm"
                                                            ToolTip="Wann der erste Teil endet. Muss zwischen Beginn und Ende dieses Zeitfensters liegen." />

                                                <ui:Button Icon="{ui:SymbolIcon SplitHorizontal24}"
                                                           Content="Teilen"
                                                           Appearance="Secondary"
                                                           Command="{Binding SplitCommand}"
                                                           Margin="0,0,8,0"
                                                           ToolTip="Teilt dieses Zeitfenster in zwei, damit sich zwei verschiedene T&#228;tigkeiten getrennt erfassen lassen." />

                                                <!-- Das Gegenstueck: Wer an der falschen
                                                     Stelle geteilt hat, soll das zuruecknehmen
                                                     koennen, ohne den Tag neu zu laden. -->
                                                <ui:Button Icon="{ui:SymbolIcon ArrowJoin20}"
                                                           Content="Zusammenf&#252;gen"
                                                           Appearance="Secondary"
                                                           Command="{Binding MergeCommand}"
                                                           Visibility="{Binding CanMerge, Converter={StaticResource BoolToVis}}"
                                                           ToolTip="F&#252;gt dieses Zeitfenster mit dem unmittelbar folgenden wieder zusammen." />
                                            </StackPanel>

                                            <ui:SymbolIcon Grid.Column="4" Symbol="CheckmarkCircle24"
                                                           FontSize="18"
                                                           Foreground="{DynamicResource GapCoveredBrush}"
                                                           Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}" />
                                        </Grid>

                                        <!-- Zeile 2: Der Text.
                                             Mehrzeilig, weil eine Leistungsbeschreibung selten
                                             in eine Zeile passt - und hoch genug fuer mehr als
                                             drei. Was hier steht, liest der Kunde auf seiner
                                             Rechnung; ein Feld, in dem drei Zeilen sichtbar
                                             sind, erzieht zu drei Zeilen. -->
                                        <ui:TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                    PlaceholderText="Was wurde in dieser Zeit getan?"
                                                    AcceptsReturn="True" TextWrapping="Wrap"
                                                    MinHeight="110" MaxHeight="260"
                                                    VerticalScrollBarVisibility="Auto"
                                                    IsEnabled="{Binding CanBook}" />

                                        <!-- Zeile 3: Ziel und Schaltflaechen, alles
                                             nebeneinander. Die Firma steht zuerst, weil sie
                                             die beiden Felder daneben einschraenkt: Ist eine
                                             gewaehlt, stehen dort nur noch ihre offenen
                                             Tickets und ihre Geraete. -->
                                        <WrapPanel>
                                            <!-- Beschreibbar und ohne Suchknopf: Getippt wird
                                                 ohnehin, und ab drei Zeichen sucht das Feld
                                                 von selbst. Ein zweites Auswahlfeld daneben
                                                 waere derselbe Inhalt an zwei Stellen. -->
                                            <Grid Margin="0,0,8,0">
                                                <ComboBox IsEditable="True"
                                                          IsTextSearchEnabled="False"
                                                          StaysOpenOnEdit="True"
                                                          Text="{Binding CompanyQuery, UpdateSourceTrigger=PropertyChanged}"
                                                          ItemsSource="{Binding Companies}"
                                                          SelectedItem="{Binding SelectedCompany, Mode=TwoWay}"
                                                          IsDropDownOpen="{Binding IsCompanyListOpen, Mode=TwoWay}"
                                                          IsEnabled="{Binding CanBook}"
                                                          MinWidth="320"
                                                          ToolTip="Firma suchen &#8212; ab drei Zeichen sucht das Feld von selbst. Die Auswahl bestimmt, welche Tickets und Ger&#228;te daneben zur Wahl stehen.">
                                                    <ComboBox.ItemContainerStyle>
                                                        <Style TargetType="ComboBoxItem">
                                                            <!-- Gesperrte Firmen bleiben
                                                                 sichtbar, aber unwaehlbar: Sie
                                                                 wegzulassen hiesse, dass
                                                                 jemand sucht und nicht findet,
                                                                 ohne zu erfahren, warum. -->
                                                            <Setter Property="IsEnabled" Value="{Binding Selectable}" />
                                                        </Style>
                                                    </ComboBox.ItemContainerStyle>
                                                </ComboBox>

                                                <!-- Der Platzhalter haengt am Suchtext und
                                                     nicht an der Auswahl: Das Feld ist
                                                     beschreibbar, und wer tippt, hat noch
                                                     nichts gewaehlt - der Platzhalter muss
                                                     trotzdem sofort weichen. -->
                                                <TextBlock Text="Firma" IsHitTestVisible="False"
                                                           Margin="10,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Visibility="{Binding CompanyQuery, Converter={StaticResource EmptyToVisible}}" />
                                            </Grid>

                                            <ui:Button Icon="{ui:SymbolIcon Dismiss24}"
                                                       ToolTip="Firmenauswahl zur&#252;cknehmen &#8212; daneben stehen dann wieder die eigenen Tickets."
                                                       Command="{Binding ClearCompanyCommand}"
                                                       Margin="0,0,8,0"
                                                       Visibility="{Binding HasCompany, Converter={StaticResource BoolToVis}}" />

                                            <Grid Margin="0,0,8,0">
                                                <ComboBox ItemsSource="{Binding Tickets}"
                                                          SelectedItem="{Binding SelectedTicket, Mode=TwoWay}"
                                                          IsEnabled="{Binding CanBook}"
                                                          MinWidth="240"
                                                          ToolTip="Das Ticket, auf das gebucht wird. Ohne Firma sind das die eigenen offenen Tickets." />

                                                <TextBlock Text="Ticket" IsHitTestVisible="False"
                                                           Margin="10,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Visibility="{Binding SelectedTicket, Converter={StaticResource EmptyToVisible}}" />
                                            </Grid>

                                            <Grid Margin="0,0,8,0">
                                                <ComboBox ItemsSource="{Binding Devices}"
                                                          SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                                          IsEnabled="{Binding CanBook}"
                                                          MinWidth="200"
                                                          ToolTip="Das Ger&#228;t, an dem gearbeitet wurde. Nur mit Zuordnung taucht die Leistung in der Ger&#228;tehistorie auf." />

                                                <TextBlock Text="Ger&#228;t" IsHitTestVisible="False"
                                                           Margin="10,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Visibility="{Binding SelectedDevice, Converter={StaticResource EmptyToVisible}}" />
                                            </Grid>

                                            <CheckBox Content="intern" IsChecked="{Binding IsInternal, Mode=TwoWay}"
                                                      IsEnabled="{Binding CanBook}"
                                                      VerticalAlignment="Center" Margin="0,0,12,0"
                                                      ToolTip="Arbeit am eigenen Haus. Der Kunde sieht diese Leistung nicht &#8212; erfasst wird sie trotzdem." />

                                            <!-- Die KI-Schaltflaechen verschwinden, wenn die
                                                 Unterstuetzung nicht eingerichtet ist. Eine
                                                 Schaltflaeche, die bei jedem Druck dasselbe
                                                 "ist nicht eingerichtet" sagt, ist schlechter
                                                 als keine. -->
                                            <ui:Button Icon="{ui:SymbolIcon TextGrammarCheckmark24}"
                                                       ToolTip="Rechtschreibung, Grammatik und Zeichensetzung korrigieren &#8212; sonst nichts."
                                                       Command="{Binding ProofreadCommand}"
                                                       Margin="0,0,8,0"
                                                       Visibility="{Binding CanUseAi, Converter={StaticResource BoolToVis}}" />

                                            <ui:Button Icon="{ui:SymbolIcon Sparkle24}"
                                                       ToolTip="Stichworte zu S&#228;tzen ausformulieren. Es wird nichts erfunden."
                                                       Command="{Binding ImproveCommand}"
                                                       Margin="0,0,8,0"
                                                       Visibility="{Binding CanUseAi, Converter={StaticResource BoolToVis}}" />

                                            <ui:Button Icon="{ui:SymbolIcon ArrowUndo24}"
                                                       ToolTip="Den Text vor der &#220;berarbeitung wiederherstellen."
                                                       Command="{Binding UndoRevisionCommand}"
                                                       Margin="0,0,12,0"
                                                       Visibility="{Binding CanUndoRevision, Converter={StaticResource BoolToVis}}" />

                                            <ui:Button Appearance="Primary"
                                                       Icon="{ui:SymbolIcon Add24}"
                                                       Content="Leistung erfassen"
                                                       Command="{Binding BookCommand}"
                                                       IsEnabled="{Binding CanBook}" />
                                        </WrapPanel>

                                        <ui:TextBlock Text="{Binding CompanyStatus}" TextWrapping="Wrap"
                                                      FontSize="12"
                                                      Visibility="{Binding CompanyStatus, Converter={StaticResource NullToCollapsed}}"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                        <ui:TextBlock Text="{Binding Status}" TextWrapping="Wrap"
                                                      FontSize="12"
                                                      Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- === Bereits erfasst ================================================ -->
                <StackPanel Visibility="{Binding HasSupports, Converter={StaticResource BoolToVis}}">
                    <ui:TextBlock Text="Bereits erfasst" FontTypography="Subtitle"
                                  Margin="0,0,0,8" />

                    <Border Style="{StaticResource CardBorder}">
                        <ItemsControl ItemsSource="{Binding Supports}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <ui:TextBlock Grid.Column="0" Text="{Binding Time}"
                                                      Style="{StaticResource TabularText}"
                                                      Margin="0,0,12,0" />
                                        <ui:TextBlock Grid.Column="1" Text="{Binding Duration}"
                                                      Style="{StaticResource TabularText}"
                                                      Margin="0,0,12,0"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <ui:TextBlock Grid.Column="2" Text="{Binding Ticket}"
                                                      Margin="0,0,12,0" VerticalAlignment="Center"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <ui:TextBlock Grid.Column="3" Text="{Binding Text}"
                                                      TextTrimming="CharacterEllipsis"
                                                      VerticalAlignment="Center"
                                                      ToolTip="{Binding Text}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
