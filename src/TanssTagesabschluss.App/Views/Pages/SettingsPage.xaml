<Page x:Class="TanssTagesabschluss.App.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:design="clr-namespace:TanssTagesabschluss.App.Design"
      Style="{StaticResource PageSurface}"
      ScrollViewer.CanContentScroll="False"
      Title="Einstellungen">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PagePadding}" MaxWidth="980"
                    HorizontalAlignment="Left" design:Spacing.Size="16">

            <!-- ===== Kopf: Speichern und Prüfen stehen OBEN ==========================
                 Beide standen einmal ganz unten. Wer eine Einstellung ändert, scrollt
                 nicht erst ans Seitenende, um sie zu sichern — und wer prüfen will, sucht
                 die Schaltfläche dort, wo die übrigen Seiten ihre führen. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <ui:TextBlock Text="Einstellungen" FontTypography="Title" />
                    <ui:TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                                  Text="Drei Angaben, von denen zwei sich selbst ermitteln."
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                            design:Spacing.Size="8">
                    <ui:Button Content="Verbindung prüfen" Icon="{ui:SymbolIcon Stethoscope24}"
                               Appearance="Secondary"
                               ToolTip="Fragt TANSS nacheinander alles ab, was dieses Werkzeug braucht — ausschliesslich lesend."
                               Command="{Binding CheckCommand}"
                               IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    <ui:Button Content="Speichern" Icon="{ui:SymbolIcon Save24}"
                               Appearance="Primary"
                               Command="{Binding SaveSettingsCommand}" />
                </StackPanel>
            </Grid>

            <ui:ProgressRing IsIndeterminate="True" Width="28" Height="28"
                             HorizontalAlignment="Left"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

            <ui:TextBlock Text="{Binding Status}" TextWrapping="Wrap"
                          Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}" />

            <ui:InfoBar Severity="Warning" IsClosable="False" IsOpen="True"
                        Title="Nicht gespeichert"
                        Visibility="{Binding HasProblems, Converter={StaticResource BoolToVis}}">
                <ui:InfoBar.Content>
                    <ItemsControl ItemsSource="{Binding Problems}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:TextBlock Text="{Binding}" TextWrapping="Wrap"
                                              FontSize="12" Margin="0,0,0,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ui:InfoBar.Content>
            </ui:InfoBar>

            <!-- ===== Verbindung ====================================================== -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel design:Spacing.Size="12">
                    <ui:TextBlock Text="Verbindung zu TANSS" FontTypography="Subtitle" />

                    <StackPanel design:Spacing.Size="4">
                        <ui:TextBlock Text="Basisadresse" FontSize="12" />
                        <ui:TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="https://tanss.beispiel.de/backend" />
                        <!-- Die häufigste Fehlerquelle überhaupt: Zeigt die Adresse auf die
                             Weboberfläche statt auf /backend, antwortet diese auf jede Anfrage
                             mit HTTP 400, und der Fehler sieht wie ein Programmfehler aus. -->
                        <ui:TextBlock FontSize="11" TextWrapping="Wrap"
                                      Text="Muss auf /backend enden. Zeigt sie auf die Weboberfläche, antwortet TANSS auf jede Anfrage mit HTTP 400."
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" design:Spacing.Size="4">
                            <ui:TextBlock Text="Anmeldename" FontSize="12" />
                            <ui:TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" design:Spacing.Size="4">
                            <ui:TextBlock Text="Kennwort" FontSize="12" />
                            <!-- KEINE Bindung: Ein gebundenes Kennwort läge im Speicher des
                                 Ansichtsmodells, solange die Seite offen ist. Gelesen wird es
                                 im Quelltext dahinter und nur für die Dauer des Aufrufs. -->
                            <PasswordBox x:Name="Password" Height="32"
                                         VerticalContentAlignment="Center"
                                         KeyDown="OnPasswordKeyDown" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" design:Spacing.Size="8">
                        <ui:Button Appearance="Primary" Content="Anmelden und Token prägen"
                                   Icon="{ui:SymbolIcon Key24}"
                                   Click="OnSignInClick"
                                   IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        <ui:Button Content="Token erneuern" Icon="{ui:SymbolIcon ArrowSync24}"
                                   Appearance="Secondary"
                                   ToolTip="Prägt nur, wenn die Restlaufzeit unter die eingestellte Schwelle gefallen ist — und übernimmt das neue Token erst nach bestandener Probe."
                                   Command="{Binding RotateTokenCommand}"
                                   IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    </StackPanel>

                    <!-- Die Mitarbeiterkennung ist eine ANZEIGE und kein Eingabefeld. Sie
                         kommt aus der Anmeldung; sie tippen zu lassen schüfe nur die
                         Gelegenheit, sie falsch zu setzen — und dann prüft das Werkzeug
                         klaglos den Tag eines Kollegen. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ui:TextBlock Grid.Row="0" Grid.Column="0" Text="Mitarbeiter"
                                      Margin="0,0,0,6" FontSize="12"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ui:TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,6"
                                      Text="{Binding EmployeeText}"
                                      Style="{StaticResource TabularText}"
                                      HorizontalAlignment="Left"
                                      ToolTip="Kommt aus der Anmeldung. An dieser Kennung hängt, wessen Zeiten geprüft werden." />

                        <ui:TextBlock Grid.Row="1" Grid.Column="0" Text="Arbeitstoken"
                                      FontSize="12"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ui:TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TokenText}"
                                      TextWrapping="Wrap" HorizontalAlignment="Left" />
                    </Grid>

                    <CheckBox Content="TLS-Zertifikat prüfen"
                              IsChecked="{Binding VerifyTls, Mode=TwoWay}"
                              ToolTip="Abgeschaltet ist die Verbindung gegen einen Angreifer in der Mitte wertlos." />

                    <ui:TextBlock Text="{Binding ConnectionStatus}" TextWrapping="Wrap"
                                  FontSize="12"
                                  Visibility="{Binding ConnectionStatus, Converter={StaticResource NullToCollapsed}}"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- ===== Letzte Prüfung ================================================== -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <ui:TextBlock Text="Letzte Prüfung" FontTypography="Subtitle"
                                  Margin="0,0,0,12" />

                    <!-- Solange nichts geprüft wurde, steht hier auch nichts. Fest eingebaute
                         grüne Haken zeigten im Schwesterprojekt einmal „Token trägt“, während
                         dasselbe Token auf jede Anfrage eine 403 erzeugte. -->
                    <ui:TextBlock TextWrapping="Wrap"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  Visibility="{Binding HasChecks, Converter={StaticResource InverseBoolToVis}}"
                                  Text="Noch nicht geprüft. „Verbindung prüfen“ oben fragt TANSS tatsächlich — Zeiterfassung, Leistungen, Abwesenheiten, eigene Firma, Tickets und Feiertage, jede mit ihrer Route. Erst danach steht hier ein Befund." />

                    <ItemsControl ItemsSource="{Binding Checks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Zeichen und Farbe folgen der Stufe. „Nicht geprüft“ ist
                                         eine eigene Stufe und sieht nicht aus wie „in Ordnung“. -->
                                    <ui:SymbolIcon Grid.Column="0" Margin="0,0,10,0"
                                                   VerticalAlignment="Top">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Symbol" Value="QuestionCircle24" />
                                                <Setter Property="Foreground" Value="{DynamicResource StateIdleBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOk}" Value="True">
                                                        <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                                        <Setter Property="Foreground" Value="{DynamicResource StateRunningBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsWarn}" Value="True">
                                                        <Setter Property="Symbol" Value="Warning24" />
                                                        <Setter Property="Foreground" Value="{DynamicResource StatePendingBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsFail}" Value="True">
                                                        <Setter Property="Symbol" Value="DismissCircle24" />
                                                        <Setter Property="Foreground" Value="{DynamicResource StateFailedBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>

                                    <StackPanel Grid.Column="1">
                                        <ui:TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <ui:TextBlock Text="{Binding Detail}" FontSize="12"
                                                      TextWrapping="Wrap"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== Eigene Firma und Bundesland ===================================== -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel design:Spacing.Size="12">
                    <ui:TextBlock Text="Eigene Firma und Bundesland" FontTypography="Subtitle" />
                    <ui:TextBlock FontSize="12" TextWrapping="Wrap"
                                  Text="Aus der Postleitzahl der eigenen Firma folgt das Bundesland, und daraus die gesetzlichen Feiertage. Ohne sie erscheint an einem Feiertag ohne Zeiterfassung ein Hinweis, der keiner sein müsste."
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <StackPanel Orientation="Horizontal" design:Spacing.Size="8">
                        <ui:Button Content="Ermitteln" Icon="{ui:SymbolIcon Search24}"
                                   Appearance="Secondary"
                                   ToolTip="Funktioniert unmittelbar nach der Anmeldung — ohne vorheriges Speichern."
                                   Command="{Binding DetectCompanyCommand}"
                                   IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        <ui:TextBlock Text="{Binding OwnCompanyName}" VerticalAlignment="Center"
                                      FontWeight="SemiBold" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" design:Spacing.Size="4">
                            <ui:TextBlock Text="Postleitzahl" FontSize="12" />
                            <ui:TextBox Text="{Binding PostalCode, UpdateSourceTrigger=PropertyChanged}"
                                        MinWidth="110" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" design:Spacing.Size="4">
                            <ui:TextBlock Text="Bundesland" FontSize="12" />
                            <ComboBox ItemsSource="{Binding FederalStates}"
                                      SelectedItem="{Binding FederalState, Mode=TwoWay}"
                                      MinWidth="260" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>

                    <!-- Wer eine Niederlassung in einem anderen Bundesland betreut als die, in
                         der die Firma gemeldet ist, hat dafür einen Grund — und eine spätere
                         Erkennung darf ihn nicht stillschweigend übergehen. -->
                    <CheckBox Content="Bundesland von Hand gesetzt (nicht mehr selbsttätig überschreiben)"
                              IsChecked="{Binding FederalStateIsManual, Mode=TwoWay}" />

                    <ui:TextBlock Text="{Binding CompanyStatus}" TextWrapping="Wrap" FontSize="12"
                                  Visibility="{Binding CompanyStatus, Converter={StaticResource NullToCollapsed}}"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- ===== Sprachmodell-Unterstützung ====================================== -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel design:Spacing.Size="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <ui:TextBlock Text="Sprachmodell-Unterstützung" FontTypography="Subtitle" />
                            <!-- Der einzige Ort, an dem Text das Haus verlässt. Das steht
                                 hier und nicht im Kleingedruckten. -->
                            <ui:TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                                          Text="Korrigiert und formuliert den Leistungstext aus. Hier verlässt als Einziges Text das Haus — standardmässig abgeschaltet, mit ausdrücklicher Einwilligung und eigenem Schlüssel."
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ui:Button Grid.Column="1" VerticalAlignment="Top"
                                   Content="Einstellen" Icon="{ui:SymbolIcon Sparkle24}"
                                   Appearance="Secondary"
                                   Command="{Binding OpenAiSettingsCommand}" />
                    </Grid>

                    <ui:TextBlock Text="{Binding AiText}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ===== Erinnerungen ==================================================== -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel design:Spacing.Size="12">
                    <ui:TextBlock Text="Erinnerungen" FontTypography="Subtitle" />
                    <ui:TextBlock FontSize="12" TextWrapping="Wrap"
                                  Text="Morgens geht es um gestern — der Tag ist vorbei, was fehlt, fehlt endgültig. Abends geht es um heute, und da lässt es sich noch in einer Minute nachtragen."
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" design:Spacing.Size="6">
                            <CheckBox Content="Morgens den Vortag prüfen"
                                      IsChecked="{Binding MorningEnabled, Mode=TwoWay}" />
                            <ui:TextBox Text="{Binding MorningTime, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="08:30" MaxWidth="110"
                                        HorizontalAlignment="Left" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" design:Spacing.Size="6">
                            <CheckBox Content="Abends vor Feierabend erinnern"
                                      IsChecked="{Binding EveningEnabled, Mode=TwoWay}" />
                            <ui:TextBox Text="{Binding EveningTime, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="16:45" MaxWidth="110"
                                        HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>

                    <!-- Eine Meldung „alles in Ordnung“, die jeden Tag erscheint, wird nach
                         einer Woche weggeklickt — und dann auch die, bei der etwas dransteht. -->
                    <CheckBox Content="Nur melden, wenn etwas offen ist"
                              IsChecked="{Binding OnlyWhenSomethingIsOpen, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- ===== Was als Lücke gilt ============================================== -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel design:Spacing.Size="12">
                    <ui:TextBlock Text="Was als Lücke gilt" FontTypography="Subtitle" />

                    <StackPanel Orientation="Horizontal" design:Spacing.Size="12">
                        <ui:TextBlock Text="Mindestdauer (Minuten)" VerticalAlignment="Center"
                                      FontSize="12" />
                        <!-- Grenzen am Bedienelement und nicht erst in der Prüfung: Sonst
                             tippt jemand 500, drückt Speichern und bekommt eine Absage für
                             etwas, das das Feld ihm gerade angeboten hat. -->
                        <ui:NumberBox Value="{Binding MinimumMinutes, Mode=TwoWay}" MinWidth="100"
                                      Minimum="1" Maximum="240"
                                      ToolTip="Kürzere Zeitfenster stehen nicht in der Liste. 15 Minuten ist die übliche Abrechnungseinheit." />

                        <ui:TextBlock Text="Rückblick (Tage)" VerticalAlignment="Center"
                                      FontSize="12" />
                        <ui:NumberBox Value="{Binding HistoryDays, Mode=TwoWay}" MinWidth="100"
                                      Minimum="1" Maximum="365"
                                      ToolTip="Wie weit der Überblick zurückreicht — 1 bis 365 Tage. Je länger, desto länger lädt er. Derselbe Wert lässt sich auch im Überblick oben rechts umstellen." />
                    </StackPanel>

                    <!-- ===== Arbeitswoche ============================================= -->
                    <!-- Sie steht hier und nicht in TANSS, weil TANSS sie nicht hergibt: Zu
                         einem Arbeitszeitmodell liefert die Schnittstelle Kennung und Namen,
                         aber keinen Wochenplan — nachgemessen gegen 10.10.0. -->
                    <StackPanel design:Spacing.Size="8">
                        <ui:TextBlock Text="Arbeitswoche" FontTypography="BodyStrong" />
                        <ui:TextBlock FontSize="12" TextWrapping="Wrap"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="TANSS nennt zu einem Arbeitszeitmodell nur dessen Namen, keinen Wochenplan — und vielen Mitarbeitern ist gar keines zugeordnet. Ohne diese Angabe muss das Werkzeug raten, welcher Tag ein Arbeitstag war." />

                        <CheckBox Content="Arbeitswoche hier festlegen"
                                  IsChecked="{Binding WorkWeekIsSet, Mode=TwoWay}"
                                  ToolTip="Abgeschaltet gilt Montag bis Freitag als Annahme, und jeder Tag sagt das auch." />

                        <WrapPanel IsEnabled="{Binding WorkWeekIsSet}">
                            <CheckBox Content="Mo" IsChecked="{Binding WorksMonday, Mode=TwoWay}" Margin="0,0,12,0" />
                            <CheckBox Content="Di" IsChecked="{Binding WorksTuesday, Mode=TwoWay}" Margin="0,0,12,0" />
                            <CheckBox Content="Mi" IsChecked="{Binding WorksWednesday, Mode=TwoWay}" Margin="0,0,12,0" />
                            <CheckBox Content="Do" IsChecked="{Binding WorksThursday, Mode=TwoWay}" Margin="0,0,12,0" />
                            <CheckBox Content="Fr" IsChecked="{Binding WorksFriday, Mode=TwoWay}" Margin="0,0,12,0" />
                            <CheckBox Content="Sa" IsChecked="{Binding WorksSaturday, Mode=TwoWay}" Margin="0,0,12,0" />
                            <CheckBox Content="So" IsChecked="{Binding WorksSunday, Mode=TwoWay}" />
                        </WrapPanel>

                        <!-- Getrennt vom Wochentag, weil es zwei verschiedene Aussagen
                             sind: „Ich arbeite Mo–Fr“ lässt sich sicher sagen, „ich bin immer
                             um 8:00 da“ nicht von jedem. -->
                        <CheckBox Content="Übliche Arbeitszeit auswerten"
                                  IsChecked="{Binding WorkHoursAreSet, Mode=TwoWay}"
                                  IsEnabled="{Binding WorkWeekIsSet}"
                                  ToolTip="Ohne diese Angabe werden nur Lücken innerhalb der gestempelten Anwesenheit gefunden — ein zu spätes Einstempeln bleibt unbemerkt." />

                        <StackPanel Orientation="Horizontal" design:Spacing.Size="12"
                                    IsEnabled="{Binding CanEditWorkHours}">
                            <ui:TextBlock Text="von" VerticalAlignment="Center" FontSize="12" />
                            <ui:TextBox Text="{Binding WorkBegin, UpdateSourceTrigger=PropertyChanged}"
                                        MinWidth="80" PlaceholderText="08:00" />
                            <ui:TextBlock Text="bis" VerticalAlignment="Center" FontSize="12" />
                            <ui:TextBox Text="{Binding WorkEnd, UpdateSourceTrigger=PropertyChanged}"
                                        MinWidth="80" PlaceholderText="17:00" />
                        </StackPanel>

                        <ui:TextBlock Text="{Binding WorkWeekText}" FontSize="12" TextWrapping="Wrap"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <ui:TextBlock FontSize="11" TextWrapping="Wrap"
                          Text="{Binding ConfigPath, StringFormat=Die Konfiguration liegt unter {0}}"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
