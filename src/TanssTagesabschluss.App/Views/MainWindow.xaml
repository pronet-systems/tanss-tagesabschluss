<!--
    Die Fensterbreite ist die Stelle, an der über sichtbare Bedienelemente entschieden wird.

    MinWidth=1100 ist gemessen und nicht gegriffen: Die breiteste Zeile ist eine Lücke auf der
    Seite „Tag“. Sie braucht 110 für die Uhrzeit, 70 für die Dauer, 260 für das Textfeld,
    240 für die Ticketauswahl, 200 für die Geräteauswahl und 3×40 für die Schaltflächen
    (Korrigieren, Ausformulieren, Erfassen) — zusammen 1000, dazu 2×16 Kartenrand und
    2×24 Seitenrand ergeben 1080. Mit dem ausgeklappten Navigationsbereich (OpenPaneLength=220)
    wären es 1300; deshalb ist der Bereich hier schmal voreingestellt und die Lückenzeile
    umbruchfähig.

    Das ist die Alternative zum Umbrechen an beliebiger Stelle: Statt eine Schaltfläche in die
    nächste Zeile rutschen zu lassen — wo sie beim nächsten Blick nicht mehr steht, wo sie
    vorher war —, lässt sich das Fenster gar nicht erst so klein ziehen.
-->
<ui:FluentWindow x:Class="TanssTagesabschluss.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:design="clr-namespace:TanssTagesabschluss.App.Design"
                 xmlns:pages="clr-namespace:TanssTagesabschluss.App.Views.Pages"
                 Title="TANSS Tagesabschluss"
                 Width="1240" Height="800"
                 MinWidth="1100" MinHeight="580"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="TANSS Tagesabschluss">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="ClockAlarm24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView Grid.Row="1"
                           x:Name="Navigation"
                           PaneDisplayMode="LeftMinimal"
                           OpenPaneLength="200"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True">

            <ui:NavigationView.MenuItems>
                <!-- „Tag“ steht zuerst, weil hier die Arbeit geschieht: Eine Lücke wird auf
                     dieser Seite geschlossen, überall sonst nur gefunden. -->
                <ui:NavigationViewItem Content="Tag" TargetPageType="{x:Type pages:DayPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="CalendarDay24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="Überblick" TargetPageType="{x:Type pages:HistoryPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="CalendarWeekStart24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Einstellungen" TargetPageType="{x:Type pages:SettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="Über" TargetPageType="{x:Type pages:AboutPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Info24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <!-- DIE AUSKUNFT ZUR ZUSTANDSPLAKETTE.

             Sie liegt im gewöhnlichen Layout und nicht in einem Popup: Das lässt sich
             abmessen, es hat keine Eigenheiten, und es überdeckt nichts, was der Techniker
             gerade liest.

             VerticalAlignment="Bottom" über zwei Zeilen: Die Fußzeile ist „Auto“ hoch, die
             Auskunft legt sich darüber und wächst nach OBEN in den Inhaltsbereich hinein. -->
        <Border Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Bottom"
                HorizontalAlignment="Left" Margin="12,0,12,40"
                MaxWidth="640" Padding="16,12" CornerRadius="8"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Visibility="{Binding IsWarningsOpen, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:TextBlock Grid.Column="0" Text="Zustand"
                                  FontTypography="BodyStrong" VerticalAlignment="Center" />

                    <ui:Button Grid.Column="1" Appearance="Transparent" Padding="6,2"
                               Icon="{ui:SymbolIcon Dismiss24}"
                               ToolTip="Schliessen"
                               Command="{Binding ToggleWarningsCommand}" />
                </Grid>

                <!-- Ohne Hinweis: der eine Satz, damit der Klick nie ins Leere geht. -->
                <ui:TextBlock Text="{Binding NoWarningText}"
                              FontSize="12" TextWrapping="Wrap"
                              Visibility="{Binding HasWarnings, Converter={StaticResource InverseBoolToVis}}"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <!-- Mit Hinweis: je Eintrag Titel, Grund und Vorschlag. Der Vorschlag ist der
                     einzige Teil, mit dem jemand etwas anfangen kann — er fällt nicht weg. -->
                <ItemsControl ItemsSource="{Binding Warnings}"
                              Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <ui:SymbolIcon Symbol="Warning24" FontSize="16"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ui:TextBlock Text="{Binding Title}"
                                                  FontTypography="BodyStrong"
                                                  TextWrapping="Wrap"
                                                  VerticalAlignment="Center" />
                                </StackPanel>
                                <ui:TextBlock Text="{Binding Reason}" FontSize="12"
                                              TextWrapping="Wrap" Margin="24,0,0,4"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:TextBlock Text="{Binding Advice}" FontSize="12"
                                              TextWrapping="Wrap" Margin="24,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Fußzeile: der Zustand, den man im Blick behalten will, ohne eine Seite zu öffnen. -->
        <Border Grid.Row="2"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,6">
            <!-- Zwei Spalten, nicht ein Feld für beides: Läge beides im selben Gitterfeld und
                 wäre nur durch HorizontalAlignment auseinandergehalten, deckte die rechte
                 Gruppe die linke zu, sobald es eng wird — und die Basisadresse links ist so
                 lang, wie die Instanz des Kunden heisst. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left"
                            Margin="0,0,16,0" design:Spacing.Size="16">
                    <StackPanel Orientation="Horizontal" design:Spacing.Size="6">
                        <!-- EINE SCHALTFLÄCHE und kein Border mit Mausereignis: Ein Klick auf
                             einen Border trifft die Beschriftung darin, und dieses Ereignis ist
                             kein zuverlässiger Weg nach oben. Eine Schaltfläche führt einen
                             Befehl, ist mit der Tastatur erreichbar und trägt das
                             Invoke-Muster — damit lässt sich der Klick nachmessen.

                             Die Vorlage ist auf den reinen Inhalt heruntergenommen: Die Farbe
                             der Plakette steckt im Border darin, und der Standardrahmen einer
                             Schaltfläche legte sich sonst darum. -->
                        <Button Command="{Binding ToggleWarningsCommand}"
                                Cursor="Hand" Padding="0"
                                BorderThickness="0" Background="Transparent"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="Zustandsplakette"
                                ToolTip="Anklicken: zeigt, was gerade zu beachten ist.">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Button.Template>
                            <Border Padding="6,1" VerticalAlignment="Center">
                                <Border.Style>
                                    <!-- Die Farbe folgt dem Zustand über Auslöser und nicht über
                                         eine Eigenschaft im Ansichtsmodell: Ein Pinsel dort wäre
                                         beim Wechsel der Darstellung eingefroren. -->
                                    <Style TargetType="Border" BasedOn="{StaticResource StatePillOnColor}">
                                        <Setter Property="Background" Value="{DynamicResource StateRunningBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status.State}" Value="Degraded">
                                                <Setter Property="Background" Value="{DynamicResource StateFailedBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status.State}" Value="NotConfigured">
                                                <Setter Property="Background" Value="{DynamicResource StatePendingBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <ui:TextBlock Text="{Binding StateText}" FontSize="11" />
                            </Border>
                        </Button>

                        <!-- Die einzige Angabe hier, deren Länge der Kunde bestimmt. Sie darf
                             kürzen, statt den Rest der Zeile hinauszuschieben. -->
                        <ui:TextBlock Text="{Binding BaseUrlText}"
                                      FontSize="12" VerticalAlignment="Center"
                                      TextTrimming="CharacterEllipsis"
                                      ToolTip="{Binding BaseUrlText}"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- Die Mitarbeiterkennung steht ausdrücklich hier: An ihr hängt alles.
                         Wer sie beim Einrichten vertippt hat, sieht klaglos die Lücken eines
                         Kollegen — und das fällt nur auf, wenn die Zahl im Blick ist. -->
                    <ui:TextBlock Text="{Binding EmployeeText}" FontSize="12" VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            design:Spacing.Size="16">
                    <!-- Sichtbar nur, wenn es wirklich etwas gibt — sonst wäre es eine
                         Dauerzeile, die nach drei Tagen niemand mehr liest. Anklickbar, weil
                         ein Hinweis ohne Weg dahin den Techniker zum Suchen zwänge. -->
                    <ui:Button Appearance="Transparent" Padding="8,2"
                               VerticalAlignment="Center"
                               Icon="{ui:SymbolIcon ArrowDownload24}"
                               Content="{Binding UpdateText}"
                               FontSize="12"
                               AutomationProperties.AutomationId="Aktualisierungshinweis"
                               ToolTip="Eine neuere Fassung steht bereit. Anklicken öffnet „Über“ — dort lässt sie sich holen."
                               Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}"
                               Click="OnUpdateHintClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
